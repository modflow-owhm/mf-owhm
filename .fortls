{
  "source_dirs": [
    "src/**",
    "postprocessors/*/src"
  ],

  "excl_paths": [
    "src/inc"
  ],

  "pp_suffixes": [".fpp", ".FPP", ".F", ".F90"],
  "pp_defs": {
    "__unix__": "",
    "__GFORTRAN__": ""
  },

  "disable_diagnostics": true,

  "hover_signature": true,
  "use_signature_help": true,
  "incremental_sync": true,
  "notify_init": true,

  "lowercase_intrinsics": false,
  "disable_autoupdate": true,
  "debug_log": false
}
